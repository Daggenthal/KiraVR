#!/usr/bin/env bash
# KiraVR AppImage launcher.
#
# SteamVR loads the driver from a registered path, and an AppImage is mounted
# at a new /tmp/.mount_* path on every start. So the streamer is copied to a
# fixed place under $HOME (only when this AppImage holds a different build),
# and the dashboard runs from there. It registers that copy with SteamVR when
# it launches SteamVR.
#
#   KiraVR.AppImage [dashboard args]   Install (first time) and open the dashboard
#   KiraVR.AppImage --preflight [--fix]  Same, runs the system check in the terminal
#   KiraVR.AppImage --diagnostics      Prints a bug report, personal details removed
#   KiraVR.AppImage --update           Ask again about a version you said no to
#   KiraVR.AppImage --rollback         Switch back to the last kept version
#   KiraVR.AppImage --uninstall        Remove the installed copy and menu entry
#
# Updates are never silent: When this AppImage holds a different version than
# the installed one, it asks twice. Saying no keeps the installed version and
# is remembered for this build. Replaced versions are kept (newest 3) in
# versions/, the dashboard's Installation tab can switch back to them.
#
# Env: KIRAVR_DEBUG=1 logs every step, NO_COLOR=1 disables colors,
# KIRAVR_NO_DESKTOP_ENTRY=1 skips the menu entry.

set -uo pipefail

KIRAVR_DEBUG="${KIRAVR_DEBUG:-0}"
if [[ -t 2 && -z "${NO_COLOR:-}" ]]; then
    RED=$'\e[31m' BOLD_RED=$'\e[1;31m' YELLOW=$'\e[33m' GREEN=$'\e[32m' CYAN=$'\e[36m' BOLD=$'\e[1m' RESET=$'\e[0m'
else
    RED="" BOLD_RED="" YELLOW="" GREEN="" CYAN="" BOLD="" RESET=""
fi
info()  { echo "${BOLD}==>${RESET} $*" >&2; }
ok()    { echo "${GREEN}OK:${RESET} $*" >&2; }
warn()  { echo "${YELLOW}Warning:${RESET} $*" >&2; }
error() { echo "${RED}Error:${RESET} $*" >&2; }
debug() { [[ "$KIRAVR_DEBUG" == "1" ]] && echo "${CYAN}debug:${RESET} $*" >&2; return 0; }
die() {
    echo "${BOLD_RED}KiraVR could not start${RESET}" >&2
    error "$*"
    # The menu entry has no terminal, so also show it on the desktop.
    if [[ ! -t 2 ]] && command -v notify-send >/dev/null; then
        notify-send -i dialog-error "KiraVR could not start" "$*" || true
    fi
    [[ "$KIRAVR_DEBUG" == "1" ]] && { warn "Debug mode: Continuing anyway"; return 0; }
    exit 1
}
[[ "$KIRAVR_DEBUG" == "1" ]] && set -x

APPDIR="${APPDIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
PAYLOAD="$APPDIR/usr/share/kiravr/streamer"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
INSTALL_ROOT="$DATA_HOME/kiravr"
INSTALL="$INSTALL_ROOT/streamer"
DESKTOP_FILE="$DATA_HOME/applications/dev.daggenthal.kiravr.desktop"
ICON_FILE="$DATA_HOME/icons/hicolor/256x256/apps/dev.daggenthal.kiravr.png"
DRIVER_DIR="$INSTALL/lib64/alvr"
VERSIONS="$INSTALL_ROOT/versions"
DECLINED="$INSTALL_ROOT/declined-build-id"
KEEP_VERSIONS=3
FORCE_ASK=0

find_vrpathreg() {
    local candidate
    for candidate in \
        "$HOME/.local/share/Steam/steamapps/common/SteamVR/bin/vrpathreg.sh" \
        "$HOME/.steam/steam/steamapps/common/SteamVR/bin/vrpathreg.sh"; do
        [[ -x "$candidate" ]] && { echo "$candidate"; return 0; }
    done
    return 1
}

uninstall() {
    info "Removing KiraVR from $INSTALL_ROOT"
    if pgrep -x vrserver >/dev/null; then
        die "SteamVR is running. Close it first."
    fi
    local vrpathreg
    if vrpathreg="$(find_vrpathreg)"; then
        "$vrpathreg" removedriver "$DRIVER_DIR" >/dev/null 2>&1 \
            && ok "Driver unregistered from SteamVR" \
            || warn "Could not unregister the driver (it may not have been registered)"
    else
        warn "SteamVR not found, skipped unregistering the driver"
    fi
    rm -rf "$INSTALL" "$INSTALL.new" "$INSTALL.old" "$VERSIONS" "$INSTALL_ROOT/rollback.tmp"
    rm -f "$DECLINED"
    rm -f "$DESKTOP_FILE" "$ICON_FILE"
    command -v update-desktop-database >/dev/null && update-desktop-database "$DATA_HOME/applications" 2>/dev/null
    ok "Uninstalled. Settings stay in ~/.config/alvr, delete that folder too for a clean slate."
    exit 0
}

# Yes/no question: A desktop dialog, the terminal, or no (the safe answer)
# when neither is there. ask <question> <yes label> <no label>
ask() {
    local question="$1" yes="$2" no="$3"
    if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] && command -v kdialog >/dev/null; then
        kdialog --title "KiraVR" --yes-label "$yes" --no-label "$no" --yesno "$question" 2>/dev/null
        return
    fi
    if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] && command -v zenity >/dev/null; then
        zenity --question --title="KiraVR" --ok-label="$yes" --cancel-label="$no" --width=420 --text="$question" 2>/dev/null
        return
    fi
    if [[ -t 0 ]]; then
        local answer
        printf '%s\n%s [y/N] ' "$question" "$yes?" >&2
        read -r answer
        [[ "$answer" == [yY]* ]]
        return
    fi
    warn "Cannot ask (no dialog program and no terminal), keeping the installed version."
    return 1
}

# Moves the active copy into versions/ and keeps only the newest few.
park_active() {
    local version id
    version="$(cat "$INSTALL/kiravr-version" 2>/dev/null || echo unknown)"
    id="$(cat "$INSTALL/kiravr-build-id" 2>/dev/null || echo unknown)"
    mkdir -p "$VERSIONS"
    rm -rf "${VERSIONS:?}/$version-$id"
    mv "$INSTALL" "$VERSIONS/$version-$id" || die "Cannot move the current version aside"
    touch "$VERSIONS/$version-$id"
    ls -1dt "$VERSIONS"/*/ 2>/dev/null | tail -n +$((KEEP_VERSIONS + 1)) | while read -r old; do
        debug "Removing old version $old"
        rm -rf "$old"
    done
}

# Switches to the newest kept version, after asking twice.
rollback() {
    local target current
    target="$(ls -1dt "$VERSIONS"/*/ 2>/dev/null | head -1)"
    target="${target%/}"
    [[ -n "$target" && -f "$target/kiravr-version" ]] || die "No older version is kept, nothing to go back to."
    current="$(cat "$INSTALL/kiravr-version" 2>/dev/null || echo unknown)"
    local old
    old="$(cat "$target/kiravr-version")"
    pgrep -x vrserver >/dev/null && die "SteamVR is running. Close it first, it uses the current version's driver."
    ask "Switch KiraVR from $current back to $old?" "Continue" "Keep $current" || { info "Kept $current"; return 0; }
    ask "Are you sure? KiraVR $current is kept, so you can switch back in the dashboard (Installation, Updates)." "Switch to $old" "Cancel" \
        || { info "Kept $current"; return 0; }
    local current_id
    current_id="$(cat "$INSTALL/kiravr-build-id" 2>/dev/null || true)"
    local staged="$INSTALL_ROOT/rollback.tmp"
    rm -rf "$staged"
    mv "$target" "$staged" || die "Cannot prepare $old"
    park_active
    mv "$staged" "$INSTALL" || die "Cannot activate $old"
    [[ -n "$current_id" ]] && echo "$current_id" > "$DECLINED"
    ok "Switched to KiraVR $old"
}

# Copies the streamer out of the AppImage. The first install just happens,
# replacing an installed version is asked twice.
install_streamer() {
    local wanted installed=""
    wanted="$(cat "$PAYLOAD/kiravr-build-id")" || die "This AppImage is damaged (no build id)."
    [[ -f "$INSTALL/kiravr-build-id" ]] && installed="$(cat "$INSTALL/kiravr-build-id")"
    debug "Bundled build $wanted, installed build ${installed:-none}"
    if [[ "$wanted" == "$installed" ]]; then
        debug "Installed copy is current"
        return 0
    fi

    local new_version old_version=""
    new_version="$(cat "$PAYLOAD/kiravr-version")"
    if [[ -n "$installed" ]]; then
        old_version="$(cat "$INSTALL/kiravr-version" 2>/dev/null || echo unknown)"
        if [[ "$FORCE_ASK" != "1" && -f "$DECLINED" && "$(cat "$DECLINED")" == "$wanted" ]]; then
            info "Starting the installed KiraVR $old_version. You said no to $new_version before, run with --update to be asked again."
            return 0
        fi
        local question="Update KiraVR from $old_version to $new_version?"
        if [[ "$new_version" == "$old_version" ]]; then
            question="Replace KiraVR $old_version with a different build of $new_version?"
        elif [[ "$old_version" == 2[0-9].* ]]; then
            # Builds before 1.0.0 carried ALVR's version numbers (21.0.0-dev14).
            question="Update KiraVR from $old_version (old numbering) to $new_version?"
        elif [[ "$(printf '%s\n%s\n' "$new_version" "$old_version" | sort -V | head -1)" == "$new_version" ]]; then
            question="Go back from KiraVR $old_version to the older $new_version?"
        fi
        if ! ask "$question

This AppImage holds KiraVR $new_version, the installed version is $old_version. KiraVR only changes when you say so." \
            "Continue" "Keep $old_version" \
            || ! ask "Are you sure? KiraVR $new_version is installed now and $old_version is kept, so you can switch back in the dashboard (Installation, Updates). The headset app needs the matching version afterwards." \
            "Install $new_version" "Cancel"; then
            echo "$wanted" > "$DECLINED"
            info "Kept KiraVR $old_version"
            return 0
        fi
    fi

    info "Installing KiraVR $new_version to $INSTALL"
    mkdir -p "$INSTALL_ROOT" || die "Cannot create $INSTALL_ROOT"
    rm -rf "$INSTALL.new" "$INSTALL.old"
    cp -a "$PAYLOAD" "$INSTALL.new" || { rm -rf "$INSTALL.new"; die "Copying to $INSTALL_ROOT failed (disk full?)"; }
    # Swap whole folders. A running vrserver keeps its already loaded driver,
    # copying over a loaded .so would crash it.
    if [[ -d "$INSTALL" ]]; then
        park_active
    fi
    mv "$INSTALL.new" "$INSTALL" || die "Cannot move the new copy into place"
    rm -f "$DECLINED"
    if pgrep -x vrserver >/dev/null; then
        warn "SteamVR is running the previous build. Restart SteamVR to use this one."
    fi
    ok "Installed"
}

# A menu entry that starts this AppImage, kept pointing at where it is now.
desktop_entry() {
    [[ "${KIRAVR_NO_DESKTOP_ENTRY:-0}" == "1" ]] && return 0
    [[ -n "${APPIMAGE:-}" ]] || { debug "Not started as an AppImage, no menu entry"; return 0; }
    local exec_line="Exec=\"$APPIMAGE\" %U"
    local wanted
    wanted="$(sed "s|^Exec=.*|$exec_line|" "$APPDIR/dev.daggenthal.kiravr.desktop")"
    # Refreshed when the AppImage moved, or a new build changed the entry or icon.
    if [[ -f "$DESKTOP_FILE" && "$(cat "$DESKTOP_FILE")" == "$wanted" ]] \
        && cmp -s "$APPDIR/dev.daggenthal.kiravr.png" "$ICON_FILE"; then
        debug "Menu entry is current"
        return 0
    fi
    mkdir -p "$(dirname "$DESKTOP_FILE")" "$(dirname "$ICON_FILE")"
    cp "$APPDIR/dev.daggenthal.kiravr.png" "$ICON_FILE"
    printf '%s\n' "$wanted" > "$DESKTOP_FILE"
    command -v update-desktop-database >/dev/null && update-desktop-database "$DATA_HOME/applications" 2>/dev/null
    ok "Added KiraVR to the application menu"
}

ROLLBACK=0
DASHBOARD_ARGS=()
for arg in "$@"; do
    case "$arg" in
        --uninstall) uninstall ;;
        --update) FORCE_ASK=1 ;;
        --rollback) ROLLBACK=1 ;;
        *) DASHBOARD_ARGS+=("$arg") ;;
    esac
done

[[ "$(uname -m)" == "x86_64" ]] || die "KiraVR needs an x86_64 PC, this is $(uname -m)."
if [[ "$ROLLBACK" == "1" ]]; then
    [[ -d "$INSTALL" ]] || die "KiraVR is not installed yet."
    rollback
else
    install_streamer
fi
desktop_entry || warn "Could not add the menu entry"

# The dashboard does not need the AppImage's variables, and SteamVR started
# from it should not see them either.
unset APPDIR APPIMAGE ARGV0 OWD
debug "Starting $INSTALL/bin/alvr_dashboard ${DASHBOARD_ARGS[*]}"
exec "$INSTALL/bin/alvr_dashboard" "${DASHBOARD_ARGS[@]}"
